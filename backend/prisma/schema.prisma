generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// [] → sigfica uma relação 1:n
// ? → sigfica uma relação 1:1

model Pessoa {
  id        Int        @id @default(autoincrement())
  nome      String
  idade     Int?
  cachorros Cachorro[]
  endereco Endereco?
}

model Cachorro {
  id       Int    @id @default(autoincrement())
  nome     String
  pessoaId Int
  pessoa   Pessoa @relation(fields: [pessoaId], references: [id])
}

model Endereco {
  id           Int        @id @default(autoincrement())
  nomeRua      String
  pessoaId Int    @unique
  pessoa   Pessoa @relation(fields: [pessoaId], references: [id])
}


