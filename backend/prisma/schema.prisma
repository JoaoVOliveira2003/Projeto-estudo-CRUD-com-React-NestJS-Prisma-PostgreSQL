generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Pessoa {
  id        Int        @id @default(autoincrement())
  nome      String
  cachorros Cachorro[]
}

model Cachorro {
  id       Int    @id @default(autoincrement())
  nome     String
  pessoaId Int
  pessoa   Pessoa @relation(fields: [pessoaId], references: [id])
}

model Endereco {
  id           Int        @id @default(autoincrement())
  nomeRua      String
}


